                "exec": [
                  "pm.test('تم', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test('غير صالح', () => pm.expect(pm.response.json().downloads[0].valid).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "مزامنة id غير موجود ← valid: false",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
