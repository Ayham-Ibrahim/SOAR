          "name": "مفتاح فك التشفير",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/videos/{{hls_video_id}}/key?t={{playback_token}}",
            "description": "يطلبه المشغّل وحده. **بدون Sanctum**: التوكن في `t` هو الصلاحية.\n\nالرد: 16 بايت خام، `application/octet-stream`، `Cache-Control: no-store, private`.\n\n403 بجسم فارغ إذا: التوكن مزوّر/منتهٍ، لفيديو آخر، أو الجلسة أُلغيت/انتهت. محدود 120 طلب/دقيقة لكل توكن، وكل جلب يُسجَّل في اللوغ.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('تم جلب المفتاح', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test('16 بايت', () => pm.expect(pm.response.stream.length).to.eql(16));",
                  "pm.test('لا يُخزَّن', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
                ]
              }
            }
          ]
        }
