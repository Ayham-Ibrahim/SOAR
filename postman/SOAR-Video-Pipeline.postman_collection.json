          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('تم جلب القائمة', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "const body = pm.response.text();",
                  "pm.test('التشفير AES-128', () => pm.expect(body).to.include('METHOD=AES-128'));",
                  "pm.test('رابط المفتاح حقيقي', () => { pm.expect(body).to.include('/key?t='); pm.expect(body).to.not.include('__KEY_URI__'); });"
                ]
              }
            }
